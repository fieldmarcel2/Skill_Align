# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillaign

# ── JWT ──────────────────────────────────────────────────────────────────
# Use a strong random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Debug ────────────────────────────────────────────────────────────────
DEBUG=false
DB_ECHO=false

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Example for local dev: http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── OTP ──────────────────────────────────────────────────────────────────
# OTP_DEV_MODE=true logs OTP to console instead of sending SMS
OTP_DEV_MODE=true
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── SMS Provider ─────────────────────────────────────────────────────────
# Not required when OTP_DEV_MODE=true
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

