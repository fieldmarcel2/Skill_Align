# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (Local or Neon)
# Local: postgresql://postgres:password@localhost:5432/skillaign
# Neon:  postgresql://USER:PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillaign

# ── Frontend URL & CORS ──────────────────────────────────────────────────
# In production on Render, set this to your Vercel URL:
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── JWT Security ─────────────────────────────────────────────────────────
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Upload & Debug ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
DEBUG=false
DB_ECHO=false

# ── AWS S3 Resume Storage ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=skillalign-resumes
AWS_REGION=us-east-1

# ── OTP & SMS ────────────────────────────────────────────────────────────
# OTP_DEV_MODE=true prints OTP to logs and skips SMS dispatch
OTP_DEV_MODE=true
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── AI & Email Integrations (Optional) ───────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@skilalign.com

