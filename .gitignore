# =============================================================================
# SkillAlign — Comprehensive .gitignore
# =============================================================================

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
*.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Python Artifacts ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
backend/.venv/
env.bak/
venv.bak/

# ── Testing & Code Quality ──────────────────────────────────────────────────
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.lcov
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ── User Uploads & Media Storage ────────────────────────────────────────────
uploads/
uploads/**
backend/uploads/
backend/uploads/**

# ── Frontend & Node ─────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
.npm/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Database & SQL Exports ──────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# ── Logs & Debugging ────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ── IDEs & Operating System ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*.swn
*~
